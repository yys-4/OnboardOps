# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://onboardops:password@localhost:5432/onboardops
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-32-chars-min
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── AI / LLM ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Fireworks AI (Serverless GLM 5.3 Flash — recommended for OnboardOps)
FIREWORKS_API_KEY=fw_...
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/glm-5p3-flash

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=onboardops-backend
JAEGER_ENDPOINT=http://localhost:16686

# ─── Service Ports ───────────────────────────────────────────────────────────
BACKEND_PORT=4000
INCIDENT_MANAGER_PORT=5001
DASHBOARD_PORT=3000

# ─── Feature Flags ───────────────────────────────────────────────────────────
ENABLE_ERROR_ENDPOINTS=true   # Set false in prod!
ENABLE_AI_FIXES=true
LOG_LEVEL=debug               # debug | info | warn | error

# ─── Incident Manager ────────────────────────────────────────────────────────
POSTMORTEM_AUTO_DRAFT=true
INCIDENT_WEBHOOK_SECRET=change-me-webhook-secret
